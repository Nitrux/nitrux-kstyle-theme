if (NOT EXISTS "@CMAKE_INSTALL_MANIFEST@")
    message(FATAL_ERROR "Install manifest not found. Run the install target first.")
endif()
file(READ "@CMAKE_INSTALL_MANIFEST@" _manifest)
string(REPLACE "\n" ";" _files "${_manifest}")
foreach (_file IN LISTS _files)
    if (EXISTS "${_file}" OR IS_SYMLINK "${_file}")
        file(REMOVE "${_file}")
    endif()
endforeach()
